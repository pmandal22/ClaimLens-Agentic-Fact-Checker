# LLM — e.g. google_genai:<gemini-model>, openai:<gpt-model>, anthropic:<claude-model>
CLAIMLENS_MODEL=
# Set only the key for your provider
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# 0 for repeatable output; "none" for models with fixed sampling (e.g. gemini-3.5-flash-lite)
LLM_TEMPERATURE=0

# Ingest: asr_ocr (faster-whisper + easyocr) or video_llm (Gemini models only)
INGEST_PATH=asr_ocr
OCR_MAX_FRAMES=30
OCR_LANGUAGES=en

# Search response cache (uses REDIS_URL; skipped automatically if Redis is down)
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL_S=86400

# Retrieval
TAVILY_API_KEY=
FACTCHECK_API_KEY=
EVIDENCE_RELEVANCE_THRESHOLD=0.5
MIN_VERDICT_EVIDENCE=2
CONFIDENCE_FLOOR=0.7

# Storage — set GCS_BUCKET to use Google Cloud Storage (auth via GOOGLE_APPLICATION_CREDENTIALS
# or workload identity); leave empty to store videos under LOCAL_STORAGE_DIR
GCS_BUCKET=
LOCAL_STORAGE_DIR=data/storage

# Local Postgres (infra/docker-compose.yml); defaults are for local development only
POSTGRES_USER=claimlens
POSTGRES_PASSWORD=claimlens
POSTGRES_DB=claimlens
POSTGRES_PORT=5432
# Set this to use Postgres for jobs when running api/worker on your machine (compose sets it itself).
# Leave unset to use the local SQLite file.
# POSTGRES_URL=postgresql://claimlens:claimlens@localhost:5432/claimlens
API_PORT=8000
# Worker containers to run (read by `make up`). Each loads its own Whisper model.
WORKER_COUNT=1

# Job queue (infra/docker-compose.yml starts Redis on this port)
REDIS_URL=redis://localhost:6379/0
# Seconds before an unacknowledged job is handed to another worker; keep above your slowest job
QUEUE_RECLAIM_AFTER_S=900

# Tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=claimlens

# Streamlit UI: where the API runs (read from the shell, not this file)
# CLAIMLENS_API_URL=http://localhost:8000

# Set to require this token (X-Review-Token header) to publish a human review
REVIEW_TOKEN=
